{
  "name": "checkyourself",
  "display_name": "CheckYourself",
  "version": "1.4.1",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Simon Gonzalez De Cruz",
  "description": "AI production-readiness diagnostic, guided fix, and learning-plan system for apps built by learning-by-doing.",
  "modes": [
    "beginner_prompt",
    "folder_diagnostic",
    "icm_style_context",
    "guided_fix_mode",
    "bespoke_learning_plan",
    "advanced_capability_stack",
    "token_efficient_context_loading",
    "context_budget_guard",
    "optional_dashboard",
    "complete_remediation_loop"
  ],
  "risk_levels": [
    "P0",
    "P1",
    "P2",
    "P3"
  ],
  "approval_required_for_changes": true,
  "model_agnostic": true,
  "entrypoints": {
    "context": "CONTEXT.md",
    "human": "START_HERE.md",
    "prompt": "PASTE_THIS_INTO_YOUR_AI.md",
    "agent": "AGENTS.md",
    "beginner": "BEGINNER_PROMPT_ONLY.md",
    "diagnostic": "02_RUN_DIAGNOSTIC/README.md",
    "guided_fix": "03_GUIDED_FIX_MODE/README.md",
    "learning_plan": "04_LEARNING_PLAN/README.md",
    "dashboard": "10_DASHBOARD/dashboard-prompt.md",
    "token_efficiency": "docs/token-efficiency-and-context-control.md",
    "user_workflow_diagram": "assets/checkyourself-user-workflow.png"
  },
  "resolution_policy": [
    "fixed",
    "accepted-risk",
    "deferred",
    "not-applicable"
  ],
  "complete_audit_required": true,
  "first_approval_batch_is_not_full_scope": true,
  "dashboard_optional": true,
  "dashboard_default": "off",
  "context_bloat_policy": "progressive-disclosure",
  "optional_dashboard": {
    "enabled": true,
    "default": false,
    "trigger": "dashboard yes",
    "template": "10_DASHBOARD/dashboard-template.html",
    "advanced_data_template": "05_OUTPUT_TEMPLATES/checkyourself-dashboard.html",
    "token_policy": "Generate only on request; compact summary only."
  },
  "context_control": {
    "default_output": "compact_markdown",
    "load_advanced_references_only_when_relevant": true,
    "use_finding_ids_to_avoid_repetition": true,
    "dashboard_generated_only_on_request": true
  },
  "complete_remediation_backlog_required": true,
  "guided_fix_loop_until_resolution": true,
  "dashboard_optional_by_default": true,
  "dashboard_requires_user_opt_in": true,
  "token_efficiency_policy": "progressive-context-loading",
  "dashboard_modes": [
    "off",
    "data",
    "html"
  ],
  "complete_findings_remain_source_of_truth": true,
  "html_dashboard_template": "05_OUTPUT_TEMPLATES/checkyourself-dashboard.html"
}
