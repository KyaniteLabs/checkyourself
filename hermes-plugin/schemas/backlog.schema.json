{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckYourself Remediation Backlog",
  "type": "object",
  "required": ["tool", "schema", "generated_at", "remediation_backlog", "first_approval_batch"],
  "properties": {
    "tool": { "type": "string" },
    "schema": { "type": "string", "enum": ["checkyourself-backlog/1"] },
    "generated_at": { "type": "string" },
    "remediation_backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "category",
          "fix_summary",
          "why_this_order",
          "verification",
          "rollback",
          "learning_value",
          "status"
        ],
        "properties": {
          "finding_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "category": { "type": "string" },
          "fix_summary": { "type": "string" },
          "why_this_order": { "type": "string" },
          "verification": { "type": "string" },
          "rollback": { "type": "string" },
          "learning_value": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "first_approval_batch": { "type": "array", "items": { "type": "string" } }
  }
}
