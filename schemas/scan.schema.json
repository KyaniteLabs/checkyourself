{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckYourself Scan Result",
  "type": "object",
  "required": [
    "tool",
    "schema",
    "generated_at",
    "project",
    "deep",
    "files_scanned",
    "stack_signals",
    "dependencies",
    "scripts",
    "env_files",
    "tests",
    "ci",
    "risk_surfaces",
    "findings",
    "counts",
    "suppression_count",
    "tree"
  ],
  "properties": {
    "tool": { "type": "string" },
    "schema": { "type": "string", "enum": ["checkyourself-scan/1"] },
    "generated_at": { "type": "string" },
    "project": { "type": "string" },
    "deep": { "type": "boolean" },
    "files_scanned": { "type": "integer", "minimum": 0 },
    "stack_signals": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "object" },
    "scripts": { "type": "object" },
    "env_files": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "ci": { "type": "array", "items": { "type": "string" } },
    "risk_surfaces": { "type": "object" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "finding",
          "plain_english_risk",
          "evidence",
          "recommended_fix",
          "status"
        ],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "finding": { "type": "string" },
          "plain_english_risk": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "recommended_fix": { "type": "string" },
          "status": { "type": "string" },
          "suppression": { "type": "object" }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": { "type": "integer", "minimum": 0 },
        "P1": { "type": "integer", "minimum": 0 },
        "P2": { "type": "integer", "minimum": 0 },
        "P3": { "type": "integer", "minimum": 0 }
      }
    },
    "suppression_count": { "type": "integer", "minimum": 0 },
    "tree": { "type": "array", "items": { "type": "string" } }
  }
}
