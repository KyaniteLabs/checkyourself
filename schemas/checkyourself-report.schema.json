{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckYourself Production Reality Report",
  "type": "object",
  "required": [
    "project",
    "score",
    "confidence",
    "findings",
    "remediation_backlog",
    "first_approval_batch",
    "learning_plan_seeds"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "coverage": {
      "type": "array",
      "description": "Audit coverage by production risk category. Missing evidence must be called out instead of silently ignored.",
      "items": {
        "type": "object",
        "required": [
          "category",
          "checked",
          "evidence_reviewed",
          "missing_evidence"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "checked": {
            "type": "boolean"
          },
          "evidence_reviewed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "follow_up_needed": {
            "type": "boolean"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Complete findings register. Do not cap findings.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "finding",
          "plain_english_risk",
          "evidence",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "finding": {
            "type": "string"
          },
          "plain_english_risk": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommended_fix": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "proposed",
              "approved",
              "fixed",
              "accepted-risk",
              "deferred",
              "not-applicable",
              "suppressed"
            ]
          }
        }
      }
    },
    "remediation_backlog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "severity",
          "fix_summary",
          "status"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "fix_summary": {
            "type": "string"
          },
          "why_this_order": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          },
          "rollback": {
            "type": "string"
          },
          "learning_value": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "proposed",
              "approved",
              "fixed",
              "accepted-risk",
              "deferred",
              "not-applicable",
              "suppressed"
            ],
            "description": "Every finding remains in the backlog until fixed, accepted-risk, deferred, not-applicable, or suppressed with reviewed evidence."
          }
        }
      }
    },
    "first_approval_batch": {
      "type": "array",
      "description": "First small set of fixes to approve. This is not the whole backlog.",
      "items": {
        "type": "string"
      }
    },
    "learning_plan_seeds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
