{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckYourself Dashboard Data",
  "description": "Accepts both the compact dashboard-data mode and the HTML-template data mode used by CheckYourself dashboard templates.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "app_name",
        "score",
        "confidence",
        "counts",
        "coverage",
        "findings"
      ],
      "properties": {
        "app_name": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "string"
        },
        "detected_stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "remediation_waves": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "next_approval": {
          "type": "string"
        },
        "learning_priorities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept": {"type": "string"},
              "plain_english": {"type": "string"},
              "plain_other_language": {"type": "string"},
              "plain_secondary_language": {"type": "string"},
              "secondary_language": {"type": "string"},
              "why": {"type": "string"},
              "triggered_by": {"type": "array", "items": {"type": "string"}},
              "do_this_next": {"type": "string"},
              "do_this_next_other_language": {"type": "string"},
              "do_this_next_secondary_language": {"type": "string"},
              "success_signal": {"type": "string"},
              "source_title": {"type": "string"},
              "source_url": {"type": "string"},
              "source_type": {"type": "string"},
              "authority_level": {"type": "string", "enum": ["high", "medium", "supplemental"]},
              "why_this_source_is_trusted": {"type": "string"},
              "checked_at": {"type": "string"},
              "youtube_title": {"type": "string"},
              "youtube_url": {"type": "string"},
              "video_trust_note": {"type": "string"},
              "video_authority_level": {"type": "string", "enum": ["high", "medium", "supplemental"]},
              "resource_title": {"type": "string"},
              "resource_url": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": [
        "project",
        "score",
        "counts",
        "coverage",
        "backlog",
        "learning_plan"
      ],
      "properties": {
        "project": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "additionalProperties": true
        },
        "do_not_ship": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "backlog": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "learning_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept": {"type": "string"},
              "plain_english": {"type": "string"},
              "plain_other_language": {"type": "string"},
              "plain_secondary_language": {"type": "string"},
              "secondary_language": {"type": "string"},
              "why": {"type": "string"},
              "practice": {"type": "string"},
              "triggered_by": {"type": "array", "items": {"type": "string"}},
              "do_this_next": {"type": "string"},
              "do_this_next_other_language": {"type": "string"},
              "do_this_next_secondary_language": {"type": "string"},
              "success_signal": {"type": "string"},
              "source_title": {"type": "string"},
              "source_url": {"type": "string"},
              "source_type": {"type": "string"},
              "authority_level": {"type": "string", "enum": ["high", "medium", "supplemental"]},
              "why_this_source_is_trusted": {"type": "string"},
              "checked_at": {"type": "string"},
              "youtube_title": {"type": "string"},
              "youtube_url": {"type": "string"},
              "video_trust_note": {"type": "string"},
              "video_authority_level": {"type": "string", "enum": ["high", "medium", "supplemental"]},
              "resource_title": {"type": "string"},
              "resource_url": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  ]
}
