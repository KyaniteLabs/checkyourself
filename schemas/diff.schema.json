{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckYourself Diff Result",
  "type": "object",
  "required": [
    "tool",
    "schema",
    "generated_at",
    "added",
    "resolved",
    "unchanged",
    "evidence_changes",
    "old_counts",
    "new_counts",
    "regression"
  ],
  "properties": {
    "tool": { "type": "string" },
    "schema": { "type": "string", "enum": ["checkyourself-diff/1"] },
    "generated_at": { "type": "string" },
    "added": { "type": "array", "items": { "type": "object" } },
    "resolved": { "type": "array", "items": { "type": "object" } },
    "unchanged": { "type": "array", "items": { "type": "string" } },
    "evidence_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "evidence_added", "evidence_resolved"],
        "properties": {
          "id": { "type": "string" },
          "evidence_added": { "type": "array", "items": { "type": "string" } },
          "evidence_resolved": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "old_counts": {
      "type": "object",
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": { "type": "integer", "minimum": 0 },
        "P1": { "type": "integer", "minimum": 0 },
        "P2": { "type": "integer", "minimum": 0 },
        "P3": { "type": "integer", "minimum": 0 }
      }
    },
    "new_counts": {
      "type": "object",
      "required": ["P0", "P1", "P2", "P3"],
      "properties": {
        "P0": { "type": "integer", "minimum": 0 },
        "P1": { "type": "integer", "minimum": 0 },
        "P2": { "type": "integer", "minimum": 0 },
        "P3": { "type": "integer", "minimum": 0 }
      }
    },
    "regression": { "type": "boolean" }
  }
}
