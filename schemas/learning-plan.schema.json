{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CheckYourself Bespoke Learning Plan",
  "type": "object",
  "required": [
    "inferred_level",
    "topics",
    "seven_day_plan",
    "thirty_day_plan"
  ],
  "properties": {
    "inferred_level": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "concept",
          "triggering_finding",
          "why_it_matters",
          "exercise"
        ],
        "properties": {
          "concept": {
            "type": "string"
          },
          "triggering_finding": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "exercise": {
            "type": "string"
          },
          "source_title": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "authority_level": {
            "type": "string",
            "enum": ["high", "medium", "supplemental"]
          },
          "why_this_source_is_trusted": {
            "type": "string"
          },
          "checked_at": {
            "type": "string"
          },
          "youtube_title": {
            "type": "string"
          },
          "youtube_url": {
            "type": "string"
          },
          "video_trust_note": {
            "type": "string"
          },
          "video_authority_level": {
            "type": "string",
            "enum": ["high", "medium", "supplemental"]
          },
          "secondary_language": {
            "type": "string"
          },
          "plain_secondary_language": {
            "type": "string"
          },
          "do_this_next_secondary_language": {
            "type": "string"
          },
          "level": {
            "type": "string"
          }
        }
      }
    },
    "seven_day_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thirty_day_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignore_for_now": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
